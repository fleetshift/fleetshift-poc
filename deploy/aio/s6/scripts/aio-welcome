#!/command/with-contenv sh
# Print the sandbox welcome after the public /readyz endpoint succeeds.
set -eu

# shellcheck disable=SC1091
. /run/ocm-resource-manager/public.env

url="${PUBLIC_ORIGIN}/readyz"
i=0
while [ "$i" -lt 30 ]; do
	if curl -sf --max-time 2 \
		--cacert /data/sandbox/pki/ca.crt \
		--noproxy "${PUBLIC_HOST}" \
		"${url}" \
		>/dev/null 2>&1; then
		break
	fi
	i=$((i + 1))
	sleep 1
done
if [ "$i" -ge 30 ]; then
	echo "aio-welcome: public readiness timed out at ${url}" >&2
	exit 1
fi

echo "OCM Resource Manager is ready."

if [ -f /run/ocm-resource-manager/dex.enabled ]; then
	cat <<EOF
Open ${PUBLIC_ORIGIN}

Demo login:
  Email:    ops@ocm-resource-manager.local
  Password: ocm-resource-manager-ops

Alternate developer login:
  Email:    dev@ocm-resource-manager.local
  Password: ocm-resource-manager-dev

The sandbox uses a local certificate. Your browser may ask you to accept it.
Press Ctrl+C to stop.
EOF
else
	cat <<EOF
Open ${PUBLIC_ORIGIN}

Login uses the configured external identity provider.
The sandbox uses a local certificate. Your browser may ask you to accept it.
Press Ctrl+C to stop.
EOF
fi
