{
  "name": "fleetshift-poc",
  "root": ".",
  "targets": {
    "build:all": {
      "dependsOn": ["server:build", "cli:build", "deploy-aio:build"]
    },
    "test:all": {
      "dependsOn": ["server:test", "cli:test", "deploy-aio:test"]
    },
    "protogen": {
      "dependsOn": ["proto:generate"]
    },
    "image:build": {
      "executor": "nx:run-commands",
      "options": {
        "envFile": ".env",
        "commands": [
          "podman build -t localhost/fleetshift-server:${IMAGE_TAG:-latest} -t quay.io/stolostron/fleetshift-server:${IMAGE_TAG:-latest} ${DEV_REGISTRY:+-t ${DEV_REGISTRY}/fleetshift-server:${IMAGE_TAG:-latest}} .",
          "podman build -f Dockerfile.local -t localhost/fleetshift-server-local:${IMAGE_TAG:-latest} -t quay.io/stolostron/fleetshift-server-local:${IMAGE_TAG:-latest} ${DEV_REGISTRY:+-t ${DEV_REGISTRY}/fleetshift-server-local:${IMAGE_TAG:-latest}} .",
          "podman build -f Dockerfile.web -t localhost/fleetshift-web:${IMAGE_TAG:-latest} -t quay.io/stolostron/fleetshift-web:${IMAGE_TAG:-latest} ${DEV_REGISTRY:+-t ${DEV_REGISTRY}/fleetshift-web:${IMAGE_TAG:-latest}} ."
        ],
        "parallel": false
      },
      "cache": false,
      "dependsOn": ["server:build"]
    },
    "image:aio": {
      "executor": "nx:run-commands",
      "options": {
        "envFile": ".env",
        "command": "podman build --pull=missing -f Dockerfile.fleetshift --build-arg SERVER_IMAGE=localhost/fleetshift-server-local:${IMAGE_TAG:-latest} --build-arg WEB_IMAGE=localhost/fleetshift-web:${IMAGE_TAG:-latest} -t quay.io/stolostron/fleetshift:${IMAGE_TAG:-latest} ${DEV_REGISTRY:+-t ${DEV_REGISTRY}/fleetshift:${IMAGE_TAG:-latest}} ."
      },
      "cache": false,
      "dependsOn": ["image:build"]
    },
    "image:push": {
      "executor": "nx:run-commands",
      "options": {
        "envFile": ".env",
        "commands": [
          "test -n \"${DEV_REGISTRY}\" || { echo 'DEV_REGISTRY not set. Push only targets your personal dev registry.'; exit 1; }",
          "podman push ${DEV_REGISTRY}/fleetshift-server:${IMAGE_TAG:-latest}",
          "podman push ${DEV_REGISTRY}/fleetshift-server-local:${IMAGE_TAG:-latest}",
          "podman push ${DEV_REGISTRY}/fleetshift-web:${IMAGE_TAG:-latest}"
        ],
        "parallel": false
      },
      "cache": false
    },
    "ui:generate-icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/generate-icons.mjs"
      },
      "cache": true,
      "inputs": ["{workspaceRoot}/tools/generate-icons.mjs"],
      "outputs": ["{workspaceRoot}/sdk/common/src/generated/pf-icons.json"]
    },
    "ui:generate-registry": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/generate-plugin-registry.mjs"
      },
      "dependsOn": ["plugins:build", "@fleetshift/gcphcp-plugin:build", "@fleetshift/kind-plugin:build"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/generate-plugin-registry.mjs",
        "{workspaceRoot}/extensions/core/client/dist/**/*",
        "{workspaceRoot}/extensions/gcphcp/client/dist/**/*",
        "{workspaceRoot}/extensions/kind/client/dist/**/*"
      ]
    },
    "ui:merge-web": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/merge-web.mjs"
      },
      "dependsOn": ["web:build", "ui:generate-registry"],
      "cache": false,
      "outputs": ["{workspaceRoot}/web"]
    },
    "ui:build": {
      "dependsOn": [
        "ui:generate-icons",
        "common:build",
        "plugins:build",
        "@fleetshift/gcphcp-plugin:build",
        "@fleetshift/kind-plugin:build",
        "web:build",
        "ui:generate-registry",
        "ui:merge-web"
      ]
    },
    "ui:dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev.mjs"
      },
      "cache": false
    },
    "ui:test": {
      "dependsOn": ["common:test"]
    },
    "ui:lint": {
      "dependsOn": [
        "web:lint",
        "common:lint",
        "plugins:lint",
        "@fleetshift/gcphcp-plugin:lint",
        "@fleetshift/kind-plugin:lint",
        "build-utils:lint",
        "web:lint:css",
        "plugins:lint:css",
        "@fleetshift/gcphcp-plugin:lint:css",
        "@fleetshift/kind-plugin:lint:css"
      ]
    },
    "pd:up": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:up" },
      "cache": false
    },
    "pd:dev": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:dev" },
      "cache": false
    },
    "pd:down": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:down" },
      "cache": false
    },
    "pd:clean": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:clean" },
      "cache": false
    },
    "pd:logs": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:logs" },
      "cache": false
    },
    "pd:status": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:status" },
      "cache": false
    },
    "pd:rebuild": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:rebuild" },
      "cache": false
    },
    "pd:rebuild-web": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:rebuild-web" },
      "cache": false
    },
    "pd:pull": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:pull" },
      "cache": false
    },
    "pd:clock-drift": {
      "executor": "nx:run-commands",
      "options": { "command": "task pd:clock-drift" },
      "cache": false
    },
    "kc:deploy": {
      "executor": "nx:run-commands",
      "options": { "command": "task keycloak:deploy" },
      "cache": false
    },
    "kc:teardown": {
      "executor": "nx:run-commands",
      "options": { "command": "task keycloak:teardown" },
      "cache": false
    },
    "kc:reset-realm": {
      "executor": "nx:run-commands",
      "options": { "command": "task keycloak:reset-realm" },
      "cache": false
    },
    "kc:add-user": {
      "executor": "nx:run-commands",
      "options": { "command": "task keycloak:add-user" },
      "cache": false
    },
    "kc:add-base-domain": {
      "executor": "nx:run-commands",
      "options": { "command": "task keycloak:add-base-domain" },
      "cache": false
    },
    "k8s:deploy": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:deploy" },
      "cache": false
    },
    "k8s:teardown": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:teardown" },
      "cache": false
    },
    "k8s:auth-setup": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:auth-setup" },
      "cache": false
    },
    "k8s:status": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:status" },
      "cache": false
    },
    "k8s:logs": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:logs" },
      "cache": false
    },
    "k8s:set-image": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:set-image" },
      "cache": false
    },
    "k8s:reset-image": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:reset-image" },
      "cache": false
    },
    "k8s:import-images": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:import-images" },
      "cache": false
    },
    "k8s:register-redirect": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:register-redirect" },
      "cache": false
    },
    "k8s:grpc-cert:deploy": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:grpc-route-cert:deploy" },
      "cache": false
    },
    "k8s:grpc-cert:teardown": {
      "executor": "nx:run-commands",
      "options": { "command": "task kubernetes:grpc-route-cert:teardown" },
      "cache": false
    }
  }
}
