# Frontend builder — produces /srv/web with all static assets.
#
# Build context must be the monorepo root (contains package.json,
# package-lock.json, and workspace declarations).
#
# Used as an init container in the compose stack:
#   command: ["cp", "-a", "/srv/web/.", "/output/"]

# ── Stage 1: build ──────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder

USER 0
WORKDIR /build

ENV NODE_OPTIONS=--max-old-space-size=4096

# Copy package manifests for layer caching
COPY package.json package-lock.json ./
COPY sdk/common/package.json sdk/common/
COPY sdk/build-utils/package.json sdk/build-utils/
COPY client/web/package.json client/web/
COPY extensions/core/client/package.json extensions/core/client/

# Copy tsconfig chain
COPY tsconfig.json ./

# Copy all source
COPY sdk/common/ sdk/common/
COPY sdk/build-utils/ sdk/build-utils/
COPY client/web/ client/web/
COPY extensions/core/client/ extensions/core/client/
COPY tools/merge-web.mjs tools/merge-web.mjs
COPY tools/generate-plugin-registry.mjs tools/generate-plugin-registry.mjs
COPY tools/generate-icons.mjs tools/generate-icons.mjs

# Install + build in one RUN so node_modules cache mount is available throughout
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/build/node_modules \
    npm install --include-workspace-root \
    -w @fleetshift/common \
    -w @fleetshift/build-utils \
    -w @fleetshift/gui \
    -w @fleetshift/mock-ui-plugins \
    && npm run build -w @fleetshift/common \
    && npm run build:ci -w @fleetshift/mock-ui-plugins \
    && node tools/generate-plugin-registry.mjs \
    && npm run build -w @fleetshift/gui \
    && node tools/merge-web.mjs

# ── Stage 2: runtime (static assets only) ───────────────────────
FROM registry.access.redhat.com/ubi9-micro:latest

COPY --from=builder /build/web/ /srv/web/

CMD ["cp", "-a", "/srv/web/.", "/output/"]
