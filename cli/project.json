{
  "name": "cli",
  "root": "cli",
  "projectType": "application",
  "tags": ["lang:go", "scope:cli"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o ../bin/fleetctl ./cmd/fleetctl",
        "cwd": "cli"
      },
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ],
      "outputs": ["{workspaceRoot}/bin/fleetctl"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash \"${NX_WORKSPACE_ROOT}/scripts/gotestsum.sh\" ./...",
        "cwd": "cli"
      },
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ]
    }
  }
}
