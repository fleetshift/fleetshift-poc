FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS build
WORKDIR /src
COPY sdk/nx-cache-proxy/go.mod sdk/nx-cache-proxy/go.sum ./
RUN for attempt in 1 2 3 4 5; do \
        if GODEBUG=http2client=0 go mod download; then exit 0; fi; \
        sleep "$((attempt * 5))"; \
    done; \
    exit 1
COPY sdk/nx-cache-proxy/ .
RUN CGO_ENABLED=0 go build -o /tmp/nx-cache-proxy ./cmd/nx-cache-proxy

FROM registry.access.redhat.com/ubi9-micro:latest
COPY --from=build /tmp/nx-cache-proxy /usr/local/bin/nx-cache-proxy
USER 1001
EXPOSE 8080
ENTRYPOINT ["nx-cache-proxy"]
