{
  "name": "proto",
  "root": "proto",
  "projectType": "library",
  "tags": ["lang:proto", "scope:api"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf generate --path proto/fleetshift"
      },
      "inputs": [
        "{projectRoot}/**/*.proto",
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.gen.yaml"
      ],
      "outputs": [
        "{workspaceRoot}/server/gen"
      ]
    }
  }
}
