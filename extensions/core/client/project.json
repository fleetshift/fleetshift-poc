{
  "name": "plugins",
  "root": "extensions/core/client",
  "sourceRoot": "extensions/core/client/src",
  "projectType": "library",
  "tags": ["scope:ui", "type:lib", "federation:remote"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist node_modules/.cache && rspack build",
        "cwd": "extensions/core/client"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rspack.config.*",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["common:build"]
    },
    "build:ci": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist node_modules/.cache && for name in overview management core signing routing setup configuration virtualization addon-demo settings; do echo \"--- $name ---\" && rspack build --config-name $name || exit 1; done",
        "cwd": "extensions/core/client"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rspack.config.*"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["common:build"]
    },
    "test:ct": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "extensions/core/client"
      },
      "cache": false
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "lint:css": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint 'src/**/*.{css,scss}' --config ../../../stylelint.config.mjs --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**'",
        "cwd": "extensions/core/client"
      }
    }
  }
}
