{
  "name": "@fleetshift/gcphcp-plugin",
  "root": "extensions/gcphcp/client",
  "sourceRoot": "extensions/gcphcp/client/src",
  "projectType": "library",
  "tags": ["scope:ui", "type:lib", "federation:remote"],
  "implicitDependencies": ["@fleetshift/gcphcp-server"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist node_modules/.cache && rspack build",
        "cwd": "extensions/gcphcp/client"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rspack.config.*",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["common:build"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "lint:css": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint 'src/**/*.{css,scss}' --config ../../../stylelint.config.mjs --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**'",
        "cwd": "extensions/gcphcp/client"
      }
    }
  }
}
