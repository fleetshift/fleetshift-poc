{
  "name": "server",
  "root": "fleetshift-server",
  "projectType": "application",
  "tags": ["lang:go", "scope:backend"],
  "implicitDependencies": ["proto"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o ../bin/fleetshift ./cmd/fleetshift",
        "cwd": "fleetshift-server"
      },
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ],
      "outputs": ["{workspaceRoot}/bin/fleetshift"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -count=1 ./...",
        "cwd": "fleetshift-server"
      },
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ]
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "go test -tags integration -count=1 -timeout 15m ./internal/addon/kind/",
          "go test -tags integration -count=1 -timeout 15m ./internal/addon/kubernetes/",
          "go test -race -count=1 ./internal/addon/kubernetes/"
        ],
        "parallel": false,
        "cwd": "fleetshift-server"
      },
      "cache": false
    }
  }
}
