{
  "name": "server",
  "root": "fleetshift-server",
  "projectType": "application",
  "tags": ["lang:go", "scope:backend"],
  "implicitDependencies": ["proto"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "task build:server",
        "cwd": "."
      },
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ],
      "outputs": ["{workspaceRoot}/bin/fleetshift"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "task test:server",
        "cwd": "."
      },
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ]
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "task test:server-integration",
        "cwd": "."
      },
      "cache": false
    }
  }
}
