// OCM Fleet UI — route contribution contracts and current build/bootstrap behavior.
// Sources: sdk/build-utils/src/extensions/{FleetPlugin,validate,types}.ts;
// extensions/core/client/rspack.config.ts; tools/generate-plugin-registry.mjs;
// server/internal/transport/http/uiconfig.go; client/web/src/routes/ConsoleRoutes.tsx;
// client/web/src/components/Root/ScalprumShell.tsx; client/web/src/extensions/;
// client/web/src/components/Search/SearchProvider.tsx; sdk/common/src/PluginLink.tsx.
// Older proposed distribution: docs/design/addon-ui-architecture.md.
// Alternative draft: docs/design/client-asset-separation.md; reconciliation unresolved.

specification {
  element component
  element store {
    style {
      shape storage
      color amber
    }
  }
  element planned {
    style {
      color gray
    }
  }
}

model {
  declarations = component 'Typed extension declarations' {
    description '''
      Rspack configs declare extensions and exposedModules using FleetPlugin.
      Routes declare id, label, component and icon CodeRefs, optional group
      and extensionPoints. Slots advertise type strings; consumers explicitly
      select and render supported extension types (for example providers or tabs).
      A slot declaration alone creates no route, breadcrumb or universal index.
    '''
  }
  build = component 'Rspack + FleetPlugin' {
    description '''
      Constructor runs validateExtensionSet, then delegates to DynamicRemotePlugin.
      Checks known-type properties, IDs, duplicate keys, same-plugin group references
      and top-level CodeRefs against exposedModules keys. Does not verify runtime
      export types, successful loading or renderability. Build success is not readiness.
    '''
  }
  artifacts = store 'Manifests + federated assets' {
    description 'DynamicRemotePlugin emits plugin manifests and Module Federation scripts. Current packaging serves plugin assets under /app.'
  }
  registry = store 'Build-generated plugin-registry.json' {
    description 'generate-plugin-registry.mjs collects recognized built plugin manifests with plugin keys, labels and asset locations. Go reads this local file when serving UI config requests.'
  }
  config = component 'Go /api/ui/config' {
    description '''
      Global bootstrap: scalprumConfig, pluginEntries, pluginPages and auth inputs.
      Route page id = pluginKey.id; path = group/id or pluginKey/id.
      Label slug is a fallback for missing/invalid id; duplicate paths are skipped.
      Scope comes from manifest name; module from component CodeRef module key.
      Includes an explicit built-in detail page, outside route projection.
    '''
  }
  userConfig = component 'Go /api/ui/user-config' {
    description 'Returns default navLayout projected from route and route-group metadata without customization. Optional auth middleware; currently no identity-specific layout persistence.'
  }
  runtime = component 'Shell + Scalprum / SDK' {
    description '''
      Shell bootstraps Scalprum from config. SDK resolves CodeRefs recursively,
      including nested properties; no proposed two-pass validator exists.
      Extension consumers handle their own supported contracts and failure states.
    '''
  }
  pages = component 'Routes + page rendering' {
    description '''
      ConsoleRoutes registers /{page.path}/* and default group redirects.
      PluginPage handles availability/enable states and ScalprumComponent rendering.
      PluginLink/navigation hooks resolve scope + module through pluginPages.
      Route existence alone does not imply enablement, permission or plugin health.
      Local cosmetic navigation grouping does not rewrite canonical page routes.
    '''
  }
  consumers = component 'Navigation + typed feature consumers' {
    description '''
      AppNav merges default navLayout with local IndexedDB overrides.
      Route/provider search eagerly resolves those two extension types and indexes
      their metadata. Inventory search separately resolves render-search extensions.
      Provider, setup and detail-tab consumers implement their own composition logic.
      This is not automatic discovery/indexing of all extension types.
    '''
  }

  // Older direct-fetch model; deliberately disconnected from current flow.
  // Asset separation is planned; direct-fetch versus Gateway/Operator is unresolved.
  oci = planned 'PLANNED: UI OCI artifact' {
    description 'Versioned manifest and JS/CSS bundle deployed to an external static asset host.'
  }
  catalog = planned 'PLANNED: runtime addon UI catalog' {
    description 'Resource manager owns UI capability metadata, dependencies and manifest/assets URLs. UI capability integration is not implemented; current discovery uses the build registry.'
  }
  host = planned 'PLANNED: external asset host' {
    description 'Deployment extracts OCI assets here. Resource manager stores metadata and URLs rather than serving addon JS bytes.'
  }
  browser = planned 'PLANNED: browser discovery' {
    description 'Older model: shell loads manifests/assets directly from external host. The Client Asset Separation draft instead proposes a same-origin Gateway and independent Operator. Delivery/authority reconciliation and bootstrap API remain unresolved.'
  }

  declarations -> build 'extensions + exposedModules'
  build -> artifacts 'validate declarations; emit manifests and scripts'
  artifacts -> registry 'collect manifests during packaging'
  registry -> config 'project routes into pages and loader config'
  registry -> userConfig 'project default navigation'
  config -> runtime 'bootstrap plugin runtime'
  artifacts -> runtime 'load federated scripts'
  config -> pages 'pluginPages'
  runtime -> pages 'federated page components'
  runtime -> consumers 'resolved typed extensions'
  userConfig -> consumers 'default navLayout'
  consumers -> pages 'navigate by canonical page paths'

  oci -> host 'deploy compiled assets'
  catalog -> browser 'metadata + URLs'
  host -> browser 'manifest + JS/CSS'
}

views {
  view index {
    title 'Feature contract — CURRENT build, bootstrap and rendering'
    include declarations, build, artifacts, registry, config, userConfig, runtime, pages, consumers
    autoLayout LeftRight
  }
  view plannedDistribution {
    title 'Feature contract — older PROPOSED direct-fetch distribution'
    description 'Not current runtime behavior or settled delivery arrangement. Sources: docs/design/addon-ui-architecture.md and the differing docs/design/client-asset-separation.md draft. Shared direction: separate asset distribution from the resource manager.'
    include oci, catalog, host, browser
    autoLayout LeftRight
  }
}
