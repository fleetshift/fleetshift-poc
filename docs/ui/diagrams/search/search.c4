// OCM Fleet UI — route contribution contracts and current search behavior.
// Sources: client/web/src/components/Search/{SearchProvider,FleetSearch}.tsx;
// client/web/src/components/Search/searchIndex.ts;
// client/web/src/components/Search/advanced/;
// client/web/src/hooks/useInventorySearch.tsx; sdk/common/src/resourceApi.ts;
// sdk/common/src/PluginLink.tsx; sdk/build-utils/src/extensions/searchResultRenderer.ts.

specification {
  element component
  element store {
    style {
      shape storage
      color amber
    }
  }
}

model {
  inputs = component 'Resolved feature inputs + layout' {
    description '''
      SearchProvider explicitly selects route and cluster-provider extensions
      with useExtensions/useResolvedExtensions. Resolution is eager, not metadata-only.
      Also reads pluginPages, install state and merged backend/local navigation.
      It does not scan all extension types or generically discover new types.
    '''
  }
  features = component 'SearchProvider feature index builder' {
    description '''
      Matches routes to pages by label/title; feature ID = pluginKey.routeId.
      Indexes routes, fallback non-detail pages, debug setting and layout groups.
      Route extensionPoints map type to parent feature; only the explicit provider
      scan uses that link today. Provider routes compose parent path with to;
      Create cluster is a hardcoded synthetic entry. Custom renderers/icons are
      held in maps; group membership includes hidden More entries.
    '''
  }
  index = store 'Client Orama feature index' {
    description 'Fuzzy ranked feature metadata search. Query attaches custom components/icons and injects missing ancestor entries through feature links. Ranking is not navigation order; inventory resources are queried separately.'
  }
  ui = component 'FleetSearch' {
    description '''
      Simple input queries local features immediately and inventory after debounce.
      Renders feature parent/child groups and resource results. Custom feature
      searchResult components can replace default rendering; inventory links use
      PluginLink scope + module resolution. Advanced mode shows resource results.
    '''
  }
  advanced = component 'Raw CEL editor + local suggestions' {
    description '''
      AdvancedSearchBar/useAdvancedSearch edit a raw CEL expression with cursor-aware
      completion, static field tree/registry, semantic Orama suggestions and local
      history. Client validation is advisory, not a network submission gate.
      This is not backend-driven field discovery or a structured visual query builder.
    '''
  }
  queries = component 'useInventorySearch query paths' {
    description '''
      Simple search hardcodes name-prefix CEL for Kind Cluster and Kubernetes
      Object kinds Pod, Namespace and Node; two requests, pageSize 5 each.
      Registering a renderer does not add a type to these simple queries.
      Advanced filterSearch sends raw CEL unchanged, pageSize 20; no pagination UI.
      Both wait for renderer resolution and turn request failures into empty results.
    '''
  }
  api = component 'Resource Query API' {
    description 'createResourceApi("-").search sends filter and pageSize to the global resource query endpoint. Backend evaluates CEL against platform-held resources; returned resources carry resourceType and resource data.'
  }
  renderers = component 'Resolved inventory renderer registry' {
    description '''
      useInventorySearch eagerly resolves ocm-fleet.render-search extensions,
      indexing resolve and optional icon by exact resourceType. These are result
      adapters, not query/type-discovery providers. resolve maps each resource to
      title, description and scope/module/relative navigation target.
    '''
  }
  results = component 'Resource result mapping' {
    description '''
      Uses the matching renderer, badge and icon, then PluginLink for navigation.
      Missing/throwing resolver falls back to resource name/type without a target.
      Raw-CEL results additionally show values of referenced fields, not proof of which boolean branch matched.
    '''
  }

  inputs -> features 'routes/providers + pages + merged groups'
  features -> index 'feature metadata and parent links'
  ui -> index 'query(term)'
  index -> ui 'ranked grouped features + renderer references'
  ui -> queries 'debounced simple term'
  advanced -> ui 'raw CEL filter'
  ui -> queries 'filterSearch(raw CEL)'
  queries -> api 'fixed simple CEL or raw advanced CEL'
  api -> results 'resource results'
  renderers -> queries 'loaded state gates requests'
  renderers -> results 'resourceType-specific resolve + icon'
  results -> ui 'resource items + reference-based links'
}

views {
  view index {
    title 'Search — CURRENT feature index and inventory query integration'
    description 'Local feature discovery and live inventory queries are separate paths. Supported extension scans and simple inventory filters are explicit, not generic type discovery.'
    include inputs, features, index, ui, advanced, queries, api, renderers, results
    autoLayout LeftRight
  }
}
