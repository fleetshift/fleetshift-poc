{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": true,
  "tui": {
    "enabled": false
  },
  "plugins": [
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build"
        },
        "runTarget": {
          "name": "docker:run"
        }
      }
    }
  ],
  "namedInputs": {
    "uiSource": [
      "{projectRoot}/src/**/*.{ts,tsx,js,jsx}",
      "{projectRoot}/tsconfig*.json"
    ],
    "uiStyles": [
      "{projectRoot}/src/**/*.{css,scss}"
    ],
    "eslintConfig": [
      "{workspaceRoot}/fleetshift-ui/eslint.config.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": ["uiSource", "eslintConfig"]
    },
    "lint:css": {
      "cache": true,
      "inputs": ["uiStyles"]
    }
  }
}
