{
  "name": "gui",
  "root": "client/web",
  "sourceRoot": "client/web/src",
  "projectType": "application",
  "tags": ["scope:ui", "type:app"],
  "implicitDependencies": ["common", "build-utils", "plugins", "@fleetshift/gcphcp-plugin", "@fleetshift/kind-plugin"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build -w @fleetshift/gui"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rspack.config.*",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["common:build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev.mjs"
      },
      "cache": false
    },
    "dev:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev.mjs --watch"
      },
      "cache": false
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"],
        "fix": true
      }
    },
    "lint:css": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint 'src/**/*.{css,scss}' --config ../../stylelint.config.mjs --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**'",
        "cwd": "client/web"
      }
    }
  }
}
