{
  "name": "server",
  "root": "server",
  "projectType": "application",
  "tags": ["lang:go", "scope:backend"],
  "implicitDependencies": ["proto"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o ../bin/fleetshift ./cmd/fleetshift",
        "cwd": "server"
      },
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ],
      "outputs": ["{workspaceRoot}/bin/fleetshift"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash \"${NX_WORKSPACE_ROOT}/scripts/gotestsum.sh\" ./...",
        "cwd": "server"
      },
      "cache": false,
      "inputs": [
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum"
      ]
    },
    "test-stress": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "systemctl --user restart podman.socket 2>/dev/null || true",
          "go test -tags stress -count=1 -run TestStress -v -timeout 0 ./internal/application/"
        ],
        "parallel": false,
        "cwd": "server"
      },
      "cache": false
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "server",
        "parallel": false,
        "commands": [
          "bash \"${NX_WORKSPACE_ROOT}/scripts/gotestsum.sh\" -tags integration -timeout 15m ./internal/addon/kind/",
          "bash \"${NX_WORKSPACE_ROOT}/scripts/gotestsum.sh\" -tags integration -timeout 15m ./internal/addon/kubernetes/",
          "bash \"${NX_WORKSPACE_ROOT}/scripts/gotestsum.sh\" -race ./internal/addon/kubernetes/"
        ]
      },
      "cache": false
    }
  }
}
