# Copy to .env and uncomment the settings for your environment:
#   Local Podman AIO: deploy/podman/README.md (SQLite and built-in Dex by default).
#   OpenShift example: deploy/openshift/README.md (PostgreSQL and external OIDC).
# OpenShift and an external identity provider are optional for local AIO use.
# The workflows share some OIDC settings but use different key-registry inputs;
# follow the relevant deployment guide rather than enabling every example below.

# ── Container Registry ──────────────────────────────────────────────
# Used by the Nx targets 'image:build', 'image:aio', and 'image:push'.
# DEV_REGISTRY=quay.io/your-quay-username
IMAGE_TAG=latest

# ── Resource manager server ─────────────────────────────────────────
# Logging settings depend on how the server is launched:
# OpenShift example: forwards this value to the server's --log-level flag.
# OCM_RM_LOG_LEVEL=info
# AIO: one setting for the server, Dex, and lifecycle logs (default: error).
# LOG_LEVEL=error
# Standalone server: pass --log-level directly.

# ── Local Podman AIO ────────────────────────────────────────────────
# Host ports published by deploy/podman/compose.yaml.
OCM_RM_SERVER_HTTP_PORT=8085
OCM_RM_SERVER_GRPC_PORT=50051

# AIO image override (compose default: quay.io/stolostron/ocm-fleet:latest).
# OCM_FLEET_IMAGE=quay.io/<user>/ocm-fleet:latest

# ── Authentication: built-in Dex or external OIDC ───────────────────
# Local AIO: leave OIDC_ISSUER_URL unset to use built-in Dex
# (ops@ocm-fleet.local / ocm-fleet-ops, dev@ocm-fleet.local / ocm-fleet-dev).
# To use an external provider, set its issuer URL; AIO then disables built-in Dex.
# The OpenShift example requires an external issuer. Keycloak is one option;
# deploy/openshift/keycloak/README.md describes the optional sample deployment.
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_UI_CLIENT_ID=ocm-fleet-console
# OIDC_RESOURCE_AUDIENCE=resource-manager
# OIDC_KEY_ENROLLMENT_AUDIENCE=resource-manager-signing
#
# For local AIO with an external IdP, register the origin
# https://ocm-fleet.localhost:8085 and redirect URLs ending in
# /app/auth/callback and /app/silent-renew.html. For OpenShift, use its Route URL.
# Configure client IDs and audiences to match your provider's registration.
# AIO only: set this if the issuer requires an additional trusted CA.
# OIDC_CA_FILE=/path/in/container/ca.crt
#
# AIO: leave OIDC_UI_SCOPE unset so packaging selects scopes for built-in Dex
# or the external issuer. See deploy/aio/README.md for overrides and defaults.

# ── Optional OpenShift application deployment ──────────────────────
# Only needed for the deploy:openshift:* application/certificate workflows.
# Set the target API URL from `oc whoami --show-server` after logging in.
# OCM_FLEET_CLUSTER_API=https://api.cluster.example.com:6443
# Set OIDC_ISSUER_URL above and the CLI client registered with your provider.
# OIDC_CLI_CLIENT_ID=fleetctl
# OIDC_AUDIENCE is a legacy alias for OIDC_RESOURCE_AUDIENCE above.
# OIDC_AUDIENCE=resource-manager
# Key-registry inputs for this deployment (AIO uses OIDC_REGISTRY_* instead).
# KEY_REGISTRY_ID=github.com
# KEY_REGISTRY_SUBJECT_EXPR=claims.github_username
# Alternatively, use a public-key claim instead of the registry mapping:
# PUBLIC_KEY_CLAIM_EXPR=claims.signing_public_key
# Configure PostgreSQL for this example; local AIO uses SQLite instead.
# POSTGRES_USER=resource_manager
# POSTGRES_PASSWORD=replace-with-your-password
# POSTGRES_DB=resource_manager

# ── Optional OpenShift supporting-service examples ─────────────────
# KC_CLUSTER_API is the current input name for the sample Keycloak and MinIO
# remote-cache deployment targets. It selects their OpenShift cluster, not an
# OIDC issuer. The supporting services may use the application cluster or another.
# KC_CLUSTER_API=https://api.services.example.com:6443

# ── Nx remote cache (optional) ──────────────────────────────────────
# NX_SELF_HOSTED_REMOTE_CACHE_SERVER=http://localhost:8420
# NX_SELF_HOSTED_REMOTE_CACHE_ACCESS_TOKEN=your-write-or-read-token
