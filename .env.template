# Copy to .env. Used by:
#   deploy/podman — AIO image (sqlite; peer Dex unless OIDC_ISSUER_URL is set)
#   deploy/openshift / deploy/openshift/keycloak — cluster deploy (different OIDC env names)

# ── Container Registry ──────────────────────────────────────────────
# Used by 'task image:build', 'task image:aio', and 'task image:push'.
# DEV_REGISTRY=quay.io/your-quay-username
IMAGE_TAG=latest

# ── Resource manager server ──────────────────────────────────────────────
OCM_RM_SERVER_HTTP_PORT=8085
OCM_RM_SERVER_GRPC_PORT=50051
OCM_RM_LOG_LEVEL=info

# AIO image override (compose default: quay.io/stolostron/ocm-fleet:latest).
# OCM_FLEET_IMAGE=quay.io/<user>/ocm-fleet:latest

# ── OIDC ────────────────────────────────────────────────────────────
# Unset OIDC_ISSUER_URL → peer Dex (ops@ocm-fleet.local / ocm-fleet-ops,
# dev@ocm-fleet.local / ocm-fleet-dev). Set it → that issuer; Dex parks.
# Register https://ocm-fleet.localhost:8085, /app/auth/callback,
# and /app/silent-renew.html on an external IdP.
# OIDC_ISSUER_URL=https://your-keycloak.example.com/realms/ocm-fleet
# OIDC_UI_CLIENT_ID=ocm-fleet-console
# OIDC_RESOURCE_AUDIENCE=resource-manager
# OIDC_KEY_ENROLLMENT_AUDIENCE=resource-manager-signing
# OIDC_CA_FILE=/path/in/container/ca.crt
#
# Leave OIDC_UI_SCOPE unset. Packaging picks Dex-on vs Dex-off from issuer.

# ── OCP Cluster URLs (task preconditions) ───────────────────────────
# oc whoami --show-server. KC_CLUSTER_API: OpenShift Keycloak and MinIO.
# OCM_FLEET_CLUSTER_API: OpenShift application and gRPC certificate workflows.
KC_CLUSTER_API=https://api.keycloak-cluster.example.com:6443
OCM_FLEET_CLUSTER_API=https://api.ocm-fleet-cluster.example.com:6443

# ── OpenShift deploy (Nx deploy:openshift:*) ──────────────────────────────
# OIDC_AUDIENCE=resource-manager
# KEY_REGISTRY_ID=github.com
# KEY_REGISTRY_SUBJECT_EXPR=claims.github_username
# PUBLIC_KEY_CLAIM_EXPR=claims.signing_public_key
POSTGRES_USER=resource_manager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=resource_manager

# ── Nx remote cache (optional) ──────────────────────────────────────
# NX_SELF_HOSTED_REMOTE_CACHE_SERVER=http://localhost:8420
# NX_SELF_HOSTED_REMOTE_CACHE_ACCESS_TOKEN=your-write-or-read-token
