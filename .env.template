# FleetShift Deployment Configuration
# Copy this file to .env and adjust values as needed.
#
# Two deploy paths read this one file:
#   - deploy/podman  → the all-in-one image (API + baked-in UI + peer Dex),
#                      sqlite only. This is the default local dev flow.
#   - deploy/kubernetes / deploy/keycloak → server + PostgreSQL + external OIDC
#                      on a cluster.
# The AIO image and the k8s deploy use DIFFERENT env var names for a few OIDC
# settings — keys used by only one path are tagged [AIO] or [k8s] below.
#
# Out of the box (OIDC_ISSUER_URL unset) the podman stack runs the built-in Dex
# sandbox IdP — no external IdP needed.

# ── Container Registry ──────────────────────────────────────────────
# Used by 'task image:build', 'task image:aio', and 'task image:push'.
# Set to your personal quay.io namespace.
DEV_REGISTRY=quay.io/your-quay-username
IMAGE_TAG=latest

# ── FleetShift Server ──────────────────────────────────────────────
FLEETSHIFT_SERVER_HTTP_PORT=8085
FLEETSHIFT_SERVER_GRPC_PORT=50051
FLEETSHIFT_LOG_LEVEL=info

# [AIO] Image overrides. Default is quay.io/stolostron/fleetshift:latest, which
# 'task podman:dev' builds locally via 'task image:aio'. Uncomment to pin another.
# FLEETSHIFT_SERVER_IMAGE=quay.io/<user>/fleetshift:latest
# FLEETSHIFT_WEB_IMAGE=quay.io/<user>/fleetshift-web:latest

# ── OIDC ────────────────────────────────────────────────────────────
# Leave OIDC_ISSUER_URL UNSET for the built-in Dex sandbox IdP (peer Dex).
# Demo users:
#   ops@fleetshift.local / fleetshift-ops
#   dev@fleetshift.local / fleetshift-dev
#
# Browser: open https://fleetshift-sandbox.localhost:8085 (redirects to /app)
# and accept the certificate warning (unknown sandbox CA). Dex is same-origin
# under /idp. Do not publish or visit port 5556. Do not install the CA into
# the host trust store. If /data still has the old issuer
# https://127.0.0.1:5556/dex, run `task pd:clean` once.
#
# UI client ID and scope are packaging/deploy defaults, not fleetshift serve
# binary defaults. Leave OIDC_UI_SCOPE unset so AIO packaging picks:
#   Dex-on:  openid profile email groups audience:server:client_id:fleetshift
#   Dex-off: openid profile email
# Compose ingests this whole file; a set OIDC_UI_SCOPE overrides Dex-on and
# drops aud=fleetshift from access tokens. Uncomment only to override.
OIDC_UI_CLIENT_ID=fleetshift-ui
# OIDC_UI_SCOPE="openid profile email"
OIDC_CLI_CLIENT_ID=fleetshift-cli
OIDC_RESOURCE_AUDIENCE=fleetshift

# ── External issuer ──────────────────────────────────────────────────
# Set OIDC_ISSUER_URL to point at a real IdP (Keycloak, etc.). Peer Dex then
# parks and never serves. Register
# https://fleetshift-sandbox.localhost:8085/app/auth/callback on that IdP.
# OIDC_ISSUER_URL=https://your-keycloak.example.com/realms/fleetshift
#
# Dex-off packaging already uses openid profile email when OIDC_UI_SCOPE is
# omitted. Do not send Dex-only scopes (groups,
# audience:server:client_id:fleetshift) to Keycloak — they fail as invalid.
#
# Optional OIDC overrides — [AIO] env names:
# OIDC_KEY_ENROLLMENT_AUDIENCE=fleetshift-signing
# OIDC_CA_FILE=/path/in/container/ca.crt
#
# Key registry — pick ONE ([AIO] env names):
# OIDC_REGISTRY_ID=github.com
# OIDC_REGISTRY_SUBJECT_EXPRESSION=claims.preferred_username
# Or resolve the signing public key straight from a token claim instead:
# OIDC_PUBLIC_KEY_CLAIM_EXPRESSION=claims.signing_public_key

# ── Local Web Watch Mode (task podman:dev LOCAL_WEB=true) ────────────
# Serves UI assets from the host web/ dir instead of the baked-in image, so
# 'npx nx run web:dev' hot-rebuilds are picked up on refresh. Path to the web
# assets source, relative to deploy/podman/.
UI_DIR=../..

# ── GCP HCP addon (optional) ────────────────────────────────────────
# Enable with GCPHCP_ENABLED=true and GCPHCP_GATEWAY_URL (the only required
# value). Do NOT commit a concrete CLS gateway URL to tracked files.
GCPHCP_ENABLED=false
GCPHCP_GATEWAY_URL=
# Optional overrides (documented defaults; leave empty to use renderer defaults):
# GCPHCP_GATEWAY_AUDIENCE=32555940559.apps.googleusercontent.com
# GCPHCP_TARGET_ID=gcphcp
# GCPHCP_GCP_PROJECT=gcp-ome-poc
# GCPHCP_GCP_REGION=us-central1
# GCPHCP_WORKFORCE_POOL=ome-hcp
# GCPHCP_WORKFORCE_PROVIDER=ome-oidc
# GCPHCP_BROKER_SA_EMAIL=hcp-idtoken-broker@gcp-ome-poc.iam.gserviceaccount.com

# ── Kubernetes deploy only (deploy/kubernetes, task k8s:*) ───────────
# The k8s deploy reads this same .env but uses DIFFERENT OIDC var names than the
# AIO image (above). Set these only for 'task kubernetes:deploy'.
# OIDC_AUDIENCE=fleetshift
# KEY_REGISTRY_ID=github.com
# KEY_REGISTRY_SUBJECT_EXPR=claims.github_username
# PUBLIC_KEY_CLAIM_EXPR=claims.signing_public_key
# PostgreSQL backend (k8s only; the AIO image is sqlite-only):
POSTGRES_USER=fleetshift
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fleetshift

# ── Keycloak on OpenShift (deploy/keycloak, task kc:*) ───────────────
# Only for the external-Keycloak-on-OCP path. Set cluster API URLs to get early
# "wrong cluster" errors instead of cryptic failures (oc whoami --show-server).
# KC_CLUSTER_API=https://api.keycloak-cluster.example.com:6443
# OME_CLUSTER_API=https://api.ome-cluster.example.com:6443
# KC_HTTPS_PORT=8443
# KC_HOSTNAME=keycloak
# Auto-create a personal Keycloak user during 'task kc:*' setup:
# DEV_USER_USERNAME=you@redhat.com
# DEV_USER_PASSWORD=mypassword
# DEV_USER_GITHUB=your-github-username
# DEV_USER_ROLES=ops,dev

# ── Nx remote cache (optional) ──────────────────────────────────────
# NX_SELF_HOSTED_REMOTE_CACHE_SERVER=http://localhost:8420
# NX_SELF_HOSTED_REMOTE_CACHE_ACCESS_TOKEN=your-write-or-read-token
