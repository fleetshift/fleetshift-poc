{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "resource-manager serve",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/ocm-resource-manager-server/cmd/resource-manager",
      "preLaunchTask": "make-debug-tmpdir",
      "args": ["serve", "--log-level", "debug", "--db", "${workspaceFolder}/.vscode/.debug-tmpdir/ocm-resource-manager-debug.db", "--http-addr", ":8090"],
      "cwd": "${workspaceFolder}/ocm-resource-manager-server",
      "console": "integratedTerminal"
    },
    {
      "name": "resource-manager serve (info)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/ocm-resource-manager-server/cmd/resource-manager",
      "preLaunchTask": "make-debug-tmpdir",
      "args": ["serve", "--db", "${workspaceFolder}/.vscode/.debug-tmpdir/ocm-resource-manager-debug.db", "--http-addr", ":8090"],
      "cwd": "${workspaceFolder}/ocm-resource-manager-server",
      "console": "integratedTerminal"
    }
  ]
}
