{
  "name": "gui",
  "root": "fleetshift-ui/gui",
  "sourceRoot": "fleetshift-ui/gui/src",
  "projectType": "application",
  "tags": ["scope:ui", "type:app"],
  "implicitDependencies": ["common", "build-utils", "plugins"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build -w @fleetshift/gui",
        "cwd": "fleetshift-ui"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rspack.config.*",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["common:build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/dev.mjs",
        "cwd": "fleetshift-ui"
      },
      "cache": false
    },
    "dev:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/dev.mjs --watch",
        "cwd": "fleetshift-ui"
      },
      "cache": false
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "{workspaceRoot}/fleetshift-ui/eslint.config.mjs",
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "{workspaceRoot}/fleetshift-ui/eslint.config.mjs",
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"],
        "fix": true
      }
    },
    "lint:css": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint 'gui/src/**/*.{css,scss}' --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**'",
        "cwd": "fleetshift-ui"
      }
    }
  }
}
