{
  "name": "build-utils",
  "root": "fleetshift-ui/build-utils",
  "sourceRoot": "fleetshift-ui/build-utils/src",
  "projectType": "library",
  "tags": ["scope:ui", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build -w @fleetshift/build-utils",
        "cwd": "fleetshift-ui"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "eslintConfig": "{workspaceRoot}/fleetshift-ui/eslint.config.mjs",
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    }
  }
}
