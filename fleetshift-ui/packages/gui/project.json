{
  "name": "gui",
  "root": "fleetshift-ui/packages/gui",
  "sourceRoot": "fleetshift-ui/packages/gui/src",
  "projectType": "application",
  "tags": ["scope:ui", "type:app"],
  "implicitDependencies": ["common", "build-utils", "plugins"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build -w @fleetshift/gui",
        "cwd": "fleetshift-ui"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rspack.config.*",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["common:build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "fleetshift-ui"
      },
      "cache": false
    },
    "dev:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev:watch",
        "cwd": "fleetshift-ui"
      },
      "cache": false
    },
    "test:ct": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:ct -w @fleetshift/gui",
        "cwd": "fleetshift-ui"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/playwright-ct.config.*"
      ],
      "cache": false
    }
  }
}
