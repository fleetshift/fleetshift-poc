{
  "name": "e2e",
  "root": "fleetshift-ui/packages/e2e",
  "projectType": "application",
  "tags": ["scope:ui", "type:e2e"],
  "implicitDependencies": ["gui"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test --workspace=packages/e2e",
        "cwd": "fleetshift-ui"
      },
      "cache": false
    },
    "e2e:headed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:headed -w @fleetshift/e2e",
        "cwd": "fleetshift-ui"
      },
      "cache": false
    }
  }
}
